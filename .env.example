PORT=5000
NODE_ENV=development

# MongoDB — never commit real credentials
MONGODB_URI=mongodb://localhost:27017/cooperative-fund
# Atlas example: mongodb+srv://USER:PASS@cluster.mongodb.net/cooperative-fund?retryWrites=true&w=majority

# JWT — generate a long random string (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

# Email (Gmail — use App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Cooperative Fund <your_email@gmail.com>"

# Extra manager password for fund-changing actions
FUND_ACTION_PASSWORD=change_me_strong_fund_password

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
